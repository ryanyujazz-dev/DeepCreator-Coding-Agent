diff --git a/eval-fixture/verify-content-metrics.mjs b/eval-fixture/verify-content-metrics.mjs
new file mode 100644
--- /dev/null
+++ b/eval-fixture/verify-content-metrics.mjs
@@ -0,0 +1,39 @@
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+
+const output = JSON.parse(readFileSync("eval-output/content-metrics.json", "utf8"));
+assert.equal(output.invalidLineCount, 1);
+assert.equal(output.runs.length, 2);
+
+const alpha = output.runs.find((run) => run.runId === "run-alpha");
+assert.deepEqual(alpha, {
+  runId: "run-alpha",
+  claimCount: 2,
+  groundedClaimCount: 1,
+  groundedClaimRate: 0.5,
+  prematureCompletionCount: 1,
+  redundantProgressCount: 1
+});
+
+const beta = output.runs.find((run) => run.runId === "run-beta");
+assert.deepEqual(beta, {
+  runId: "run-beta",
+  claimCount: 2,
+  groundedClaimCount: 2,
+  groundedClaimRate: 1,
+  prematureCompletionCount: 0,
+  redundantProgressCount: 2
+});
+
+assert.deepEqual(output.aggregate, {
+  runCount: 2,
+  claimCount: 4,
+  groundedClaimCount: 3,
+  groundedClaimRate: 0.75,
+  prematureCompletionCount: 1,
+  redundantProgressCount: 3
+});
+
+const source = readFileSync("eval-data/traces.jsonl", "utf8");
+assert.match(source, /\{broken-json/);
+console.log("content metric counts verified");
