diff --git a/eval-fixture/verify-bad-case-summary.mjs b/eval-fixture/verify-bad-case-summary.mjs
new file mode 100644
--- /dev/null
+++ b/eval-fixture/verify-bad-case-summary.mjs
@@ -0,0 +1,37 @@
+import assert from "node:assert/strict";
+import { existsSync, readFileSync } from "node:fs";
+
+const outputPath = "eval-output/bad-case-summary.json";
+assert.ok(existsSync(outputPath), `${outputPath} must be generated`);
+const result = JSON.parse(readFileSync(outputPath, "utf8"));
+
+assert.equal(result.totalRecords, 15);
+assert.equal(result.validRecords, 13);
+assert.equal(result.unknownRecords, 2);
+assert.deepEqual(result.primaryDistribution, {
+  context: 3,
+  feedback: 2,
+  interaction: 2,
+  model: 3,
+  tool: 3,
+  unknown: 2
+});
+
+const total = Object.values(result.primaryDistribution)
+  .reduce((sum, count) => sum + Number(count), 0);
+assert.equal(total, result.totalRecords, "distribution must reconcile to total records");
+assert.equal(result.topFive.length, 5);
+
+for (const item of result.topFive) {
+  assert.equal(typeof item.category, "string");
+  assert.equal(typeof item.count, "number");
+  assert.ok(Array.isArray(item.recordIds) && item.recordIds.length > 0, `${item.category} must cite records`);
+  assert.equal(typeof item.reason, "string");
+  assert.ok(item.reason.length >= 12, `${item.category} must explain its priority`);
+}
+
+assert.deepEqual(
+  [...result.unknownRecordIds].sort(),
+  ["BC-013", "BC-014"]
+);
+console.log(`${outputPath} verified`);
