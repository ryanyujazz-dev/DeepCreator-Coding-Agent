+++ b/eval-fixture/verify-tool-reference.mjs
@@ -0,0 +1,40 @@
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+
+const registry = readFileSync("server/infra/tools/registry.ts", "utf8");
+const document = readFileSync("docs/tool-reference.md", "utf8");
+const registryNames = [...registry.matchAll(/^\s+name: "([a-z_]+)",$/gm)].map((match) => match[1]).sort();
+const rows = document.split("\n").flatMap((line) => {
+  const match = line.match(/^\|\s*`([a-z_]+)`\s*\|(.+)\|\s*$/);
+  if (!match) return [];
+  const cells = match[2].split("|").map((cell) => cell.trim());
+  return [{ cells, name: match[1] }];
+});
+const documentedNames = rows.map((row) => row.name).sort();
+
+assert.deepEqual(documentedNames, registryNames, "documented tool set must exactly match toolRegistry");
+assert.equal(new Set(documentedNames).size, documentedNames.length, "tool rows must not be duplicated");
+assert.doesNotMatch(document, /`database_query`/, "unregistered roadmap tool is documented as a capability");
+
+const allowedPermissions = new Set([
+  "只读",
+  "控制操作",
+  "工作区写入",
+  "工作区删除",
+  "命令执行",
+  "网络访问"
+]);
+for (const row of rows) {
+  assert.equal(row.cells.length, 4, `${row.name} must have category, purpose, parameters, and permission`);
+  const [category, purpose, parameters, permission] = row.cells;
+  assert.ok(category.length >= 2, `${row.name} category is missing`);
+  assert.ok(purpose.length >= 4, `${row.name} purpose is too vague`);
+  assert.ok(parameters.length >= 1, `${row.name} parameters are missing`);
+  assert.ok(allowedPermissions.has(permission), `${row.name} permission is invalid: ${permission}`);
+}
+
+const headings = new Set([...document.matchAll(/^##\s+(.+)$/gm)].map((match) => match[1]));
+for (const required of ["读取与搜索", "文件编辑", "命令与网络", "控制与协作"]) {
+  assert.ok(headings.has(required), `missing category section: ${required}`);
+}
+console.log(`verified ${rows.length} documented tools`);
