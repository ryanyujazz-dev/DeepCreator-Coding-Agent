{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepcreator.local/evals/agent-eval-result.schema.json",
  "title": "DeepCreator Agent Eval Result",
  "type": "object",
  "required": [
    "caseId",
    "runId",
    "sessionId",
    "model",
    "promptVersion",
    "attempt",
    "startedAt",
    "finishedAt",
    "scores",
    "hardFailures",
    "metrics",
    "attribution",
    "assertionResults",
    "passed"
  ],
  "properties": {
    "caseId": { "type": "string", "pattern": "^CAE-[0-9]{3}$" },
    "runId": { "type": "string" },
    "sessionId": { "type": "string" },
    "model": { "type": "string" },
    "promptVersion": { "type": "string" },
    "attempt": { "type": "integer", "minimum": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "scores": {
      "type": "object",
      "required": ["taskOutcome", "processContent", "toolTrajectory", "verification", "safety", "efficiency", "total"],
      "properties": {
        "taskOutcome": { "type": "number", "minimum": 0, "maximum": 30 },
        "processContent": {
          "type": "object",
          "required": ["evidenceGrounding", "analysisAndJudgment", "logicalProgression", "userValue", "total"],
          "properties": {
            "evidenceGrounding": { "type": "number", "minimum": 0, "maximum": 7 },
            "analysisAndJudgment": { "type": "number", "minimum": 0, "maximum": 7 },
            "logicalProgression": { "type": "number", "minimum": 0, "maximum": 6 },
            "userValue": { "type": "number", "minimum": 0, "maximum": 5 },
            "total": { "type": "number", "minimum": 0, "maximum": 25 }
          },
          "additionalProperties": false
        },
        "toolTrajectory": { "type": "number", "minimum": 0, "maximum": 15 },
        "verification": { "type": "number", "minimum": 0, "maximum": 15 },
        "safety": { "type": "number", "minimum": 0, "maximum": 10 },
        "efficiency": { "type": "number", "minimum": 0, "maximum": 5 },
        "total": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "hardFailures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "evidenceEventIds"],
        "properties": {
          "rule": { "type": "string" },
          "evidenceEventIds": { "type": "array", "items": { "type": "string" } },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "groundedClaimRate",
        "substantiveContentRate",
        "groundedAnalysisRate",
        "factInterpretationLinkRate",
        "genericPlaceholderCount",
        "prematureCompletionCount",
        "redundantProgressCount",
        "toolPrecision",
        "verificationCompleted",
        "userInterventionCount",
        "toolCallCount",
        "durationMs"
      ],
      "properties": {
        "groundedClaimRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "substantiveContentRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "groundedAnalysisRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "factInterpretationLinkRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "genericPlaceholderCount": { "type": "integer", "minimum": 0 },
        "prematureCompletionCount": { "type": "integer", "minimum": 0 },
        "redundantProgressCount": { "type": "integer", "minimum": 0 },
        "toolPrecision": { "type": "number", "minimum": 0, "maximum": 1 },
        "verificationCompleted": { "type": "boolean" },
        "userInterventionCount": { "type": "integer", "minimum": 0 },
        "toolCallCount": { "type": "integer", "minimum": 0 },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "judgeFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dimension", "score", "reason", "evidenceEventIds", "confidence"],
        "properties": {
          "dimension": { "type": "string" },
          "score": { "type": "number", "minimum": 0 },
          "reason": { "type": "string" },
          "evidenceEventIds": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "assertionResults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assertionId", "kind", "passed", "pointsAwarded", "pointsAvailable", "detail"],
        "properties": {
          "assertionId": { "type": "string" },
          "kind": { "type": "string" },
          "passed": { "type": "boolean" },
          "pointsAwarded": { "type": "number", "minimum": 0 },
          "pointsAvailable": { "type": "number", "minimum": 0 },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "attribution": {
      "type": "object",
      "required": ["primaryLayer", "secondaryLayers", "failureCodes", "evidenceEventIds"],
      "properties": {
        "primaryLayer": { "enum": ["none", "model", "tool", "context", "interaction", "feedback"] },
        "secondaryLayers": {
          "type": "array",
          "items": { "enum": ["model", "tool", "context", "interaction", "feedback"] },
          "uniqueItems": true
        },
        "failureCodes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "evidenceEventIds": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "passed": { "type": "boolean" }
  },
  "additionalProperties": false
}
