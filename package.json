{
  "name": "deepcreator-codeagent",
  "productName": "DeepCreator",
  "description": "A local-first desktop coding agent.",
  "author": "DeepCreator",
  "version": "0.1.7",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanyujazz-dev/DeepCreator-Coding-Agent.git"
  },
  "workspaces": [
    "services/auth"
  ],
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:all": "concurrently \"npm:dev:runtime\" \"npm:dev\"",
    "dev:preview": "concurrently \"npm:dev:runtime\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "dev:runtime": "tsx server/index.ts",
    "dev:runtime:watch": "tsx watch server/index.ts",
    "dev:desktop": "electron-forge start",
    "dev:desktop:local-auth": "node scripts/run-desktop-dev.mjs",
    "dev:auth": "npm run dev --workspace @deepcreator/auth-service",
    "build:auth": "npm run build --workspace @deepcreator/auth-service",
    "auth:migrate": "npm run migrate --workspace @deepcreator/auth-service",
    "auth:secrets": "node services/auth/scripts/generate-auth-secrets.mjs",
    "test:auth:integration": "tsx --tsconfig tsconfig.tests.json --test --test-name-pattern=\"completes GitHub login\" tests/authService.test.ts",
    "eval:list": "tsx --tsconfig tsconfig.evals.json evals/src/cli.ts list",
    "eval:run": "tsx --tsconfig tsconfig.evals.json evals/src/cli.ts run",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "lint": "npm run lint:code && npm run lint:styles",
    "lint:code": "eslint src server shared desktop services/auth/src tests evals/src *.ts --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "build": "npm run typecheck && vite build",
    "release:validate-version": "node scripts/validate-release-version.mjs",
    "release:verify-package": "node scripts/verify-packaged-app.mjs",
    "release:smoke-windows-installer": "pwsh -NoProfile -File scripts/smoke-windows-installer.ps1",
    "package:mac": "npm run release:validate-version && node scripts/validate-release-auth.mjs && electron-forge package --platform=darwin && npm run release:verify-package -- --platform=darwin",
    "package:windows": "npm run release:validate-version && node scripts/validate-release-auth.mjs && electron-forge package --platform=win32 --arch=x64 && npm run release:verify-package -- --platform=win32 --arch=x64",
    "make:mac": "npm run release:validate-version && node scripts/validate-release-auth.mjs && electron-forge make --platform=darwin && npm run release:verify-package -- --platform=darwin",
    "make:mac:arm64": "npm run release:validate-version && node scripts/validate-release-auth.mjs && electron-forge make --platform=darwin --arch=arm64 && npm run release:verify-package -- --platform=darwin --arch=arm64",
    "make:mac:x64": "npm run release:validate-version && node scripts/validate-release-auth.mjs && electron-forge make --platform=darwin --arch=x64 && npm run release:verify-package -- --platform=darwin --arch=x64",
    "make:windows": "npm run release:validate-version && node scripts/validate-release-auth.mjs && electron-forge make --platform=win32 --arch=x64 && npm run release:verify-package -- --platform=win32 --arch=x64",
    "test": "tsx --tsconfig tsconfig.tests.json --test tests/**/*.test.ts",
    "test:architecture": "tsx --tsconfig tsconfig.tests.json --test tests/architecture.test.ts",
    "typecheck": "tsc -b --pretty false",
    "typecheck:shared": "tsc -b tsconfig.shared.json --pretty false",
    "typecheck:server": "tsc -b tsconfig.server.json --pretty false",
    "typecheck:auth": "tsc -b tsconfig.auth.json --pretty false",
    "typecheck:renderer": "tsc -b tsconfig.renderer.json --pretty false",
    "typecheck:desktop": "tsc -b tsconfig.desktop.json --pretty false",
    "typecheck:evals": "tsc -b tsconfig.evals.json --pretty false",
    "typecheck:tests": "tsc -b tsconfig.tests.json --pretty false",
    "check": "npm run lint && npm run typecheck && npm run test:architecture && npm test && npm run build && npm run audit:prod",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@pierre/diffs": "1.2.12",
    "adm-zip": "^0.6.0",
    "electron-squirrel-startup": "^1.0.1",
    "fastify": "^5.10.0",
    "jsonc-parser": "^3.3.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.16.0",
    "minimatch": "^10.2.5",
    "monaco-editor": "0.53.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "safe-regex2": "^5.1.1",
    "update-electron-app": "^3.3.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.7",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "43.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "stylelint": "^17.14.1",
    "tsx": "^4.23.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.3"
  }
}
