{
  "name": "deepseeker-codeagent",
  "productName": "DeepSeeker",
  "version": "0.1.0",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:all": "concurrently \"npm:dev:runtime\" \"npm:dev\"",
    "dev:runtime": "tsx server/index.ts",
    "dev:runtime:watch": "tsx watch server/index.ts",
    "dev:desktop": "electron-forge start",
    "build": "tsc && vite build",
    "package:mac": "electron-forge package --platform=darwin",
    "make:mac": "electron-forge make --platform=darwin",
    "test": "tsx --test tests/**/*.test.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.16.0",
    "minimatch": "^10.2.5",
    "monaco-editor": "0.53.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^8.1.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^10.0.3",
    "electron": "43.1.1",
    "tsx": "^4.23.0",
    "typescript": "^5.6.3"
  }
}
