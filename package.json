{
  "name": "deepseeker-codeagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:all": "concurrently \"npm:dev:runtime\" \"npm:dev\"",
    "dev:runtime": "tsx server/index.ts",
    "dev:runtime:watch": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "test": "tsx --test tests/**/*.test.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^10.0.3",
    "tsx": "^4.23.0",
    "typescript": "^5.6.3"
  }
}
